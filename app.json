{
	"version": "1.23",
	"label": "app.name",
	"paths": ["air"],

	"architecture": {"engine": "starlark", "version": 4},
	"execute": ["lib/attachments.star", "air.star"],

	"require": {"version": {"minimum": "0.4.228"}},

	"database": {
		"file": "air.db",
		"schema": 10,
		"create": {"function": "database_create"},
		"upgrade": {"function": "database_upgrade"},
	},

	"icons_disabled": [
		{"action": "", "label": "app.name", "file": "images/icon.svg"}
	],

	"actions": {
		"": {"file": "web/dist/index.html"},
		"log": {"file": "web/dist/index.html"},   // a real page path: the same declaration the root uses, and the SPA router takes it from there
		"assets": {"files": "web/dist/assets"},
		"images": {"files": "web/dist/images"},
		"aircraft": {"files": "web/dist/aircraft"},
		"vessels": {"files": "web/dist/vessels"},
		"maps": {"files": "web/dist/maps"},
		"flight": {"files": "web/dist/flight"},
		"basis": {"files": "web/dist/basis"},
		"tracking-1.0.1": {"files": "web/dist/tracking-1.0.1"},
		"-/config/load": {"function": "config_load"},
		"-/config/save": {"function": "config_save"},
		"-/match/record": {"function": "match_record"},
		"-/match/list": {"function": "match_list"},
		"-/servers": {"function": "servers"},
		"-/recording/save": {"function": "recording_save"},
		"-/recording/pin": {"function": "recording_pin"},
		"-/recording/fetch": {"function": "recording_fetch"}
	}
}
