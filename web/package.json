{
  "name": "Mochi Air",
  "private": false,
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "if [ \"$BUILD_LOCALES\" = en ]; then vite build; else tsc -b && vite build; fi",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "knip": "pnpm -C ../../.. exec knip --workspace apps/help/web",
    "i18n:extract": "lingui extract",
    "i18n:check": "lingui extract --clean && git diff --exit-code -- src/locales || (echo \"\\033[1;31mCatalogs out of date — run pnpm i18n:extract and commit.\\033[0m\" && exit 1)"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.5.7",
    "@lingui/core": "^5.9.5",
    "@lingui/react": "^5.9.5",
    "@mochi/web": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-table": "^8.21.3",
    "cmdk": "1.1.1",
    "date-fns": "^4.4.0",
    "input-otp": "^1.4.2",
    "js-cookie": "^3.0.8",
    "lucide-react": "^0.545.0",
    "react": "19.2.1",
    "react-day-picker": "9.11.1",
    "react-dom": "19.2.1",
    "react-hook-form": "^7.83.0",
    "react-top-loading-bar": "^3.0.2",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "three": "^0.160.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@lingui/cli": "^5.9.5",
    "@lingui/swc-plugin": "^5.11.0",
    "@lingui/vite-plugin": "^5.9.5",
    "@tanstack/eslint-plugin-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/router-plugin": "^1.168.23",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^25.9.5",
    "@types/react": "19.2.1",
    "@types/react-dom": "19.2.1",
    "@types/three": "^0.160.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "gltfpack": "^1.2.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
